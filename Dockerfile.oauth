# Dockerfile.oauth — Full mode with Node.js for OAuth/claude-code-sdk
# Build: docker build -f Dockerfile.oauth -t lisf-agent-oauth .
# Run:   docker run -p 8080:8080 --env-file .env lisf-agent-oauth

FROM python:3.12-slim

# Install Node.js (required by claude-code-sdk CLI)
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code

WORKDIR /app

# Install Python dependencies (base + OAuth)
COPY requirements.txt requirements-oauth.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-oauth.txt

# Create non-root user (Claude CLI refuses --dangerously-skip-permissions as root)
RUN useradd -m -s /bin/bash appuser

# Copy application
COPY app.py index.html favicon.svg build_index.py generic_keywords.txt ./
COPY docs/ docs/
COPY subagents_outputs/lisf_faq.json subagents_outputs/lisf_faq.json
COPY subagents_outputs/titulo_answers.json subagents_outputs/titulo_answers.json

# Build search index from per-article files
RUN python build_index.py

# Prepare credentials mount point and set ownership
RUN mkdir -p /home/appuser/.claude && chown -R appuser:appuser /app /home/appuser/.claude

USER appuser

ENV PORT=8080

EXPOSE ${PORT}

CMD uvicorn app:app --host 0.0.0.0 --port ${PORT} --workers 1
